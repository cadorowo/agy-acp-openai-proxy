# Port to listen on (default: 1234)
PORT=1234

# Command to spawn the ACP backend
ACP_COMMAND=agy-acp

# Default ACP Model
ACP_MODEL=gemini-3.8-flash-high

# Optional API key for authenticating incoming requests
# If not set, requests are unauthenticated
PROXY_API_KEY=your-secret-api-key-here

# PASEO_AGY_ACP_OFFICIAL_BIN=/usr/local/bin/agy-acp-kernel-compat-active
